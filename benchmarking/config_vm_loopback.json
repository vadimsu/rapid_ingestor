{
	"sources":{
		"otel_in":{
			"type":"opentelemetry",
			"grpc":{ "address": "127.0.0.1:8888"}
		},
		"fluent_forward_in":{
			"type":"fluent_forward",
			"tcp":{ "address": "127.0.0.1:24224"}
		}
	},
	"sinks":{
		"clickhouse_otel":{
			"type":"clickhouse",
			"inputs":["otel_in.traces"],
			"database_table":"events",
			"mode":"raw_text",
			"host":"127.0.0.1",
			"port":9000,
			"dbname":"events",
			"username":"default",
			"password":"default",
			"max_rows_per_insert":10000,
			"max_batch_rows":1000000,
			"max_batch_bytes":10485760,
			"backpressure_pause_rows":1000000,
			"backpressure_resume_rows":400000,
			"backpressure_pause_bytes":209715200,
			"backpressure_resume_bytes":104857600
		},
		"clickhouse_fluent":{
			"type":"clickhouse",
			"inputs":["fluent_forward_in"],
			"database_table":"events",
			"mode":"raw_text",
			"host":"127.0.0.1",
			"port":9000,
			"dbname":"events",
			"username":"default",
			"password":"default",
			"max_rows_per_insert":10000,
			"max_batch_rows":1000000,
			"max_batch_bytes":10485760,
			"backpressure_pause_rows":1000000,
			"backpressure_resume_rows":400000,
			"backpressure_pause_bytes":209715200,
			"backpressure_resume_bytes":104857600
		}
	}
}
